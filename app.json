{
  "expo": {
    "name": "또박",
    "slug": "ttobak",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ttobak",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.ttobak.app",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#388BFD"
      }
    },
    "ios": {
      "bundleIdentifier": "com.ttobak.app",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#388BFD",
          "sounds": [
            "./assets/alarm.wav"
          ]
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
